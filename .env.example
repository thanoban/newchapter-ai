# Web application -> orchestrator
ORCHESTRATOR_BASE_URL=http://localhost:8080
ORCHESTRATOR_SERVICE_TOKEN=replace-with-a-service-to-service-token

# Vertex AI service
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_MODEL=gemini-2.5-flash

# Beyond Presence / LiveKit media service
BEY_API_KEY=replace-with-a-server-side-key
BEY_AVATAR_ID=replace-with-an-avatar-id
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-with-a-server-side-key
LIVEKIT_API_SECRET=replace-with-a-server-side-secret
