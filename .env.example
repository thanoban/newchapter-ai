# Web application -> orchestrator
ORCHESTRATOR_BASE_URL=http://localhost:8080
ORCHESTRATOR_SERVICE_TOKEN=replace-with-a-service-to-service-token

# Vertex AI service
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_MODEL=gemini-2.5-flash

# Beyond Presence managed agent (LiveKit credentials are issued per call)
BEY_API_KEY=replace-with-a-server-side-key
BEY_AGENT_ID=replace-with-a-managed-agent-id
